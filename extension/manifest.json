{
  "manifest_version": 3,
  "name": "FocusFlow AI",
  "version": "1.0",
  "description": "AI-powered focus sessions with distraction detection.",
  "permissions": [
    "tabs",
    "storage",
    "notifications",
    "alarms",
    "sidePanel",
    "scripting",
    "activeTab"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*"
    ]
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Click to open FocusFlow"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "nudge.js",
        "icons/*.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}